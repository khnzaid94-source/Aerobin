# Copy this file to .env.local and fill in a real key to enable live PM2.5.
#
# Get a free key at https://openweathermap.org/api (Air Pollution API).
# Without a key, all three apps still work — they fall back to the
# pilot's own PM2.5 baseline (E1_pm25.current in aerobin_data.json) and
# show an "offline" indicator instead of a live reading.
VITE_OPENWEATHER_API_KEY=

# Copy this file to .env.local and fill in a real key to enable live PM2.5.
#
# Get a free key at https://openweathermap.org/api (Air Pollution API).
# Without a key, all three apps still work — they fall back to the
# pilot's own PM2.5 baseline (E1_pm25.current in aerobin_data.json) and
# show an "offline" indicator instead of a live reading.
VITE_OPENWEATHER_API_KEY=

# AI features (server-side only — NEVER use a VITE_ prefix here).
#
# Get a free key at https://aistudio.google.com/apikey (Gemini API).
# On Vercel: Settings -> Environment Variables -> add GEMINI_API_KEY
# (Production + Preview). Local dev with serverless functions requires
# `vercel dev` so process.env can see it; plain `vite` will simply show
# the honest "AI not configured" notice and everything else keeps working.
GEMINI_API_KEY=

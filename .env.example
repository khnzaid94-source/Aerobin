# Copy this file to .env.local and fill in a real key to enable live PM2.5.
#
# Get a free key at https://openweathermap.org/api (Air Pollution API).
# Without a key, all three apps still work — they fall back to the
# pilot's own PM2.5 baseline (E1_pm25.current in aerobin_data.json) and
# show an "offline" indicator instead of a live reading.
VITE_OPENWEATHER_API_KEY=

# AI features (server-side only — NEVER use a VITE_ prefix here).
#
# Get a free key at https://aistudio.google.com/apikey (Gemini API).
# On Vercel: Settings -> Environment Variables -> add GEMINI_API_KEY
# (Production + Preview). Local dev with serverless functions requires
# `vercel dev` so process.env can see it; plain `vite` will simply show
# the honest "AI not configured" notice and everything else keeps working.
GEMINI_API_KEY=

# NASA FIRMS satellite burn detection (server-side only).
#
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/area/
# (~24h approval). Without it, the satellite hotspot line simply doesn't
# render — no fake data, same honesty contract as everything else.
FIRMS_MAP_KEY=

# Supabase persistence (client-side by design — protected by RLS).
#
# 1. Create a free project at https://supabase.com/dashboard (name it aerobin)
# 2. SQL Editor -> paste supabase/schema.sql -> Run (creates tables + RLS)
# 3. Settings -> API -> copy Project URL and anon public key
# The anon key is public-by-design: RLS policies (supabase/schema.sql) allow
# only anonymous INSERTs (+ reads on dispatch_log) — never updates/deletes.
# Without these vars, the app degrades to localStorage-only v1.0 behavior.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE on the burn-risk model (Phase 7): it needs NO keys at all.
# public/models/burn-risk-v0.1.onnx runs client-side via onnxruntime-web
# and /model's live try-it fetches weather/PM2.5 from the keyless
# Open-Meteo APIs — it works with an entirely empty .env.local.
